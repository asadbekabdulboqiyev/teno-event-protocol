{
  "name": "tep-typescript",
  "version": "1.0.0",
  "description": "Teno Event Protocol (TEP) — TS implementation for nescom / nesto-codebase",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && npm run test:only",
    "test:only": "node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["tep", "protocol", "event", "server-to-server", "hmac", "idempotent"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}